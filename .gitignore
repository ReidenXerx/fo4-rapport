/build/
/out/
/dist/
/vcpkg_installed/
/extern/*/build/
.vs/
.vscode/
.idea/
*.user

# Python bytecode from tools/
__pycache__/
*.pyc

# Generated by tools/make_overlays.py -- 15 MB of deterministic binary that the
# generator reproduces exactly (every texture is seeded). Same reason build/ is
# ignored. Run the tool before deploying; deploy-dev.ps1 warns if you did not.
/data/Textures/
/data/Materials/
/data/F4SE/Plugins/F4EE/

# Logs. The ones in docs/runs/ are EVIDENCE and are committed deliberately;
# anything else is a file pulled off somebody's machine, and Rapport.log carries
# the Windows user name in its own file paths.
*.log
!/docs/runs/*.log

# Local overrides of the build and deploy paths, so a machine's own layout never
# has to be committed to make the scripts run.
/scripts/*.local.ps1
/scripts/local.*
voice/renders/
voice/vanilla/
voice/pcm/
voice/ab/
voice/play/

# The voice-similarity environment (torch + speechbrain, ~3 GB) and its caches.
/.venv-voice/
/voice/fallback/wav/
/voice/fallback/models/
# Rebuilt from the game's own archives by scripts/voice-inventory.py (1 MB).
/voice/fallback/inventory.json
/voice/fallback/embeddings.npz

# Ivy's REAL lines, copied from her mod for the owner's ear test. Not ours to publish.
/voice/audition/ivy/ivy_real_*.wav
/voice/fallback/wav-mods/
/voice/fallback/embeddings-mods.npz
/voice/fallback/profiles/work/
/voice/audition/ivy/today_*.wav
/voice/audition/ivy/today_*.wav
/voice/retired/
