{
  "modName": "Rapport",
  "displayName": "Rapport",
  "minMcmVersion": 1,
  "pluginRequirements": [
    "Rapport.esp"
  ],
  "pages": [
    {
      "pageDisplayName": "Scene choice",
      "content": [
        {
          "type": "text",
          "text": "How Rapport scores a pair. With Chemistry installed, Chemistry makes the decision and adds its own bonuses on top of this score; without it, Rapport's own trigger starts a scene when the best pair clears the bar."
        },
        {
          "type": "section",
          "text": "The bar"
        },
        {
          "type": "slider",
          "id": "fMinimumScore:Scoring",
          "text": "Score needed (Rapport's own trigger)",
          "help": "The score the best pair must reach before Rapport's built-in trigger starts a scene. Chemistry has its own bar and ignores this one.",
          "valueOptions": {
            "min": 0.0,
            "max": 5.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "section",
          "text": "Who counts as a pair"
        },
        {
          "type": "slider",
          "id": "fMaxPairDistance:Scoring",
          "text": "Furthest apart",
          "help": "Two people further apart than this (game units) are never paired.",
          "valueOptions": {
            "min": 256,
            "max": 4096,
            "step": 64,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fProximity:Scoring",
          "text": "Closeness weight",
          "help": "What standing close together is worth. It falls off with the square of distance.",
          "valueOptions": {
            "min": 0.0,
            "max": 3.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fSharedFaction:Scoring",
          "text": "Same faction",
          "help": "Bonus when both belong to a shared faction.",
          "valueOptions": {
            "min": 0.0,
            "max": 2.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fInterior:Scoring",
          "text": "Indoors",
          "help": "Bonus for being indoors.",
          "valueOptions": {
            "min": 0.0,
            "max": 2.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fNight:Scoring",
          "text": "Night",
          "help": "Bonus at night.",
          "valueOptions": {
            "min": 0.0,
            "max": 2.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "section",
          "text": "Privacy"
        },
        {
          "type": "slider",
          "id": "fObserverRadius:Scoring",
          "text": "Onlooker radius",
          "help": "Anyone within this distance of the pair counts as watching.",
          "valueOptions": {
            "min": 300,
            "max": 3000,
            "step": 50,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "iObserverTolerance:Scoring",
          "text": "Free onlookers",
          "help": "Onlookers who cost nothing. The crowd penalty starts after this many. Chemistry uses the same number.",
          "valueOptions": {
            "min": 0,
            "max": 10,
            "step": 1,
            "sourceType": "ModSettingInt"
          }
        },
        {
          "type": "slider",
          "id": "fPerObserver:Scoring",
          "text": "Crowd penalty",
          "help": "Cost per onlooker past the free ones, before the curve below.",
          "valueOptions": {
            "min": 0.0,
            "max": 1.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fObserverFalloff:Scoring",
          "text": "Crowd curve",
          "help": "How steeply the crowd penalty climbs: 1 is a straight line, higher punishes big crowds harder.",
          "valueOptions": {
            "min": 1.0,
            "max": 3.0,
            "step": 0.1,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "fPlayerNear:Scoring",
          "text": "Player watching",
          "help": "Cost when the player is nearby. 0 by default: the player is not a factor.",
          "valueOptions": {
            "min": 0.0,
            "max": 2.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        }
      ]
    },
    {
      "pageDisplayName": "Voices",
      "content": [
        {
          "type": "section",
          "text": "Scene lines"
        },
        {
          "type": "switcher",
          "id": "bEnabled:Barks",
          "text": "Pair lines",
          "help": "The two in a scene say something as it starts.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "type": "slider",
          "id": "fResponderDelaySeconds:Barks",
          "text": "Answer after (s)",
          "help": "How long the second one waits before answering.",
          "valueOptions": {
            "min": 1.0,
            "max": 15.0,
            "step": 0.5,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "section",
          "text": "Bystanders"
        },
        {
          "type": "switcher",
          "id": "bEnabled:Observers",
          "text": "Bystander comments",
          "help": "People who see or hear a scene turn their head and may comment.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "type": "slider",
          "id": "iRadius:Observers",
          "text": "Notice radius",
          "help": "How far away a bystander can notice a scene.",
          "valueOptions": {
            "min": 200,
            "max": 3000,
            "step": 50,
            "sourceType": "ModSettingInt"
          }
        },
        {
          "type": "slider",
          "id": "iHearRadius:Observers",
          "text": "Hearing radius",
          "help": "Within this distance a bystander hears it through walls. Never more than the notice radius.",
          "valueOptions": {
            "min": 0,
            "max": 3000,
            "step": 50,
            "sourceType": "ModSettingInt"
          }
        },
        {
          "type": "slider",
          "id": "fChance:Observers",
          "text": "Chance to comment",
          "help": "Each bystander who notices rolls once per scene.",
          "valueOptions": {
            "min": 0.0,
            "max": 1.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "type": "slider",
          "id": "iStartAfterSeconds:Observers",
          "text": "Start after (s)",
          "help": "No comments in the first seconds of a scene.",
          "valueOptions": {
            "min": 0,
            "max": 120,
            "step": 1,
            "sourceType": "ModSettingInt"
          }
        },
        {
          "type": "slider",
          "id": "iGapSeconds:Observers",
          "text": "Gap between comments (s)",
          "help": "So two bystanders never talk over each other.",
          "valueOptions": {
            "min": 0,
            "max": 60,
            "step": 1,
            "sourceType": "ModSettingInt"
          }
        },
        {
          "type": "slider",
          "id": "iCooldownSeconds:Observers",
          "text": "Per-person cooldown (s)",
          "help": "How long before the same bystander comments again.",
          "valueOptions": {
            "min": 0,
            "max": 1800,
            "step": 30,
            "sourceType": "ModSettingInt"
          }
        }
      ]
    },
    {
      "pageDisplayName": "Narrator",
      "content": [
        {
          "type": "text",
          "text": "A line on the HUD saying who is about to have a scene and why, then the numbers behind it. It covers every mod that uses Rapport, anywhere in the loaded area."
        },
        {
          "type": "section",
          "text": "Narrator"
        },
        {
          "type": "switcher",
          "id": "bEnabled:Narrator",
          "text": "Narrator",
          "help": "Show narration at all.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "type": "switcher",
          "id": "bNumbers:Narrator",
          "text": "Show the numbers",
          "help": "A second line with the score, part by part.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "type": "section",
          "text": "What to narrate"
        },
        {
          "type": "switcher",
          "id": "bSceneStarts:Narrator",
          "text": "A scene starts",
          "help": "Who, and why now.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "type": "switcher",
          "id": "bNearMisses:Narrator",
          "text": "Why nothing happened",
          "help": "Now and then, a likely pair that was passed over and why. Rate-limited.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "type": "switcher",
          "id": "bRelationshipTurns:Narrator",
          "text": "Relationship turns",
          "help": "A first time together, or a bond crossing a line: getting close, close, inseparable, fallen out.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "type": "switcher",
          "id": "bBystanders:Narrator",
          "text": "Bystanders react",
          "help": "Someone noticed, or heard.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "type": "switcher",
          "id": "bAddonLines:Narrator",
          "text": "Addon moments",
          "help": "What a mod built on Rapport has to say in its own words: how a conversation went, and why.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "type": "section",
          "text": "Names"
        },
        {
          "type": "switcher",
          "id": "bEnabled:Names",
          "text": "Names for the nameless",
          "help": "Someone with no name of their own - a settler, a drifter - gets one the first time a mod introduces them, and keeps it.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "type": "section",
          "text": "History"
        },
        {
          "type": "button",
          "text": "Show recent narration",
          "help": "The last entries, with the time in the world.",
          "action": {
            "type": "CallGlobalFunction",
            "script": "Rapport:Narrator",
            "function": "ShowHistory",
            "params": []
          }
        },
        {
          "type": "section",
          "text": "Pacing"
        },
        {
          "type": "slider",
          "id": "iNearMissCooldownSeconds:Narrator",
          "text": "Between 'why not' lines (s)",
          "help": "At most one near miss this often, across all pairs.",
          "valueOptions": {
            "min": 30,
            "max": 1800,
            "step": 30,
            "sourceType": "ModSettingInt"
          }
        },
        {
          "type": "slider",
          "id": "iPairMissCooldownSeconds:Narrator",
          "text": "Same pair again after (s)",
          "help": "How long before the same two are narrated as a near miss again.",
          "valueOptions": {
            "min": 60,
            "max": 7200,
            "step": 60,
            "sourceType": "ModSettingInt"
          }
        }
      ]
    },
    {
      "pageDisplayName": "Debug",
      "content": [
        {
          "type": "text",
          "text": "Scenes on demand, for testing. Face the actor you mean, then click - or bind a key below and press it in game. FORCED skips the score bar, cooldowns, privacy and time of day; REAL obeys every rule and says on the HUD which one refused. Adults only, one scene at a time - always."
        },
        {
          "type": "section",
          "text": "A scene with you"
        },
        {
          "type": "button",
          "text": "A scene with the one I face - FORCED",
          "help": "You and the actor you are facing (a few steps away), through Rapport's own scene request. Skips the score bar, cooldowns, privacy and time of day.",
          "action": {
            "type": "CallGlobalFunction",
            "script": "Rapport:DebugTriggers",
            "function": "SceneWithMeForced",
            "params": []
          }
        },
        {
          "type": "button",
          "text": "A scene with the one I face - REAL",
          "help": "The same, obeying every rule a real request obeys (their cooldown included). The HUD says which rule refused.",
          "action": {
            "type": "CallGlobalFunction",
            "script": "Rapport:DebugTriggers",
            "function": "SceneWithMeReal",
            "params": []
          }
        },
        {
          "type": "section",
          "text": "A scene for them"
        },
        {
          "type": "button",
          "text": "The one I face + their best partner - FORCED",
          "help": "The actor you are facing, with the partner Rapport's own pairing ranks best nearby. Skips the score bar, cooldowns, privacy and time of day.",
          "action": {
            "type": "CallGlobalFunction",
            "script": "Rapport:DebugTriggers",
            "function": "SceneForThemForced",
            "params": []
          }
        },
        {
          "type": "button",
          "text": "The one I face + their best partner - REAL",
          "help": "The same, only if that pair clears the bar and nobody is resting - exactly as autonomy would decide. The HUD says why not.",
          "action": {
            "type": "CallGlobalFunction",
            "script": "Rapport:DebugTriggers",
            "function": "SceneForThemReal",
            "params": []
          }
        },
        {
          "type": "section",
          "text": "A pair of one kind"
        },
        {
          "type": "text",
          "text": "The best pair of that kind near you. Face someone to make them one of the two - or face nobody and let Rapport rank everyone in range."
        },
        {
          "type": "button",
          "text": "Best F+F pair nearby - FORCED",
          "help": "The best-ranked pair of two women near you. If the one you face fits, they are one of the two. Skips the score bar, cooldowns, privacy and time of day.",
          "action": {
            "type": "CallGlobalFunction",
            "script": "Rapport:DebugTriggers",
            "function": "PairFFForced",
            "params": []
          }
        },
        {
          "type": "button",
          "text": "Best F+F pair nearby - REAL",
          "help": "The same, only if that pair clears the bar and nobody is resting. The HUD says why not.",
          "action": {
            "type": "CallGlobalFunction",
            "script": "Rapport:DebugTriggers",
            "function": "PairFFReal",
            "params": []
          }
        },
        {
          "type": "button",
          "text": "Best F+M pair nearby - FORCED",
          "help": "The best-ranked pair of a woman and a man near you. If the one you face fits, they are one of the two. Skips the score bar, cooldowns, privacy and time of day.",
          "action": {
            "type": "CallGlobalFunction",
            "script": "Rapport:DebugTriggers",
            "function": "PairFMForced",
            "params": []
          }
        },
        {
          "type": "button",
          "text": "Best F+M pair nearby - REAL",
          "help": "The same, only if that pair clears the bar and nobody is resting. The HUD says why not.",
          "action": {
            "type": "CallGlobalFunction",
            "script": "Rapport:DebugTriggers",
            "function": "PairFMReal",
            "params": []
          }
        },
        {
          "type": "button",
          "text": "Best M+M pair nearby - FORCED",
          "help": "The best-ranked pair of two men near you. If the one you face fits, they are one of the two. Skips the score bar, cooldowns, privacy and time of day.",
          "action": {
            "type": "CallGlobalFunction",
            "script": "Rapport:DebugTriggers",
            "function": "PairMMForced",
            "params": []
          }
        },
        {
          "type": "button",
          "text": "Best M+M pair nearby - REAL",
          "help": "The same, only if that pair clears the bar and nobody is resting. The HUD says why not.",
          "action": {
            "type": "CallGlobalFunction",
            "script": "Rapport:DebugTriggers",
            "function": "PairMMReal",
            "params": []
          }
        },
        {
          "type": "section",
          "text": "Hotkeys"
        },
        {
          "id": "RapportSceneWithMeForced",
          "text": "With me - forced",
          "type": "hotkey",
          "help": "You and the actor you are facing (a few steps away), through Rapport's own scene request. Skips the score bar, cooldowns, privacy and time of day."
        },
        {
          "id": "RapportSceneWithMeReal",
          "text": "With me - real",
          "type": "hotkey",
          "help": "The same, obeying every rule a real request obeys (their cooldown included). The HUD says which rule refused."
        },
        {
          "id": "RapportSceneForThemForced",
          "text": "For them - forced",
          "type": "hotkey",
          "help": "The actor you are facing, with the partner Rapport's own pairing ranks best nearby. Skips the score bar, cooldowns, privacy and time of day."
        },
        {
          "id": "RapportSceneForThemReal",
          "text": "For them - real",
          "type": "hotkey",
          "help": "The same, only if that pair clears the bar and nobody is resting - exactly as autonomy would decide. The HUD says why not."
        },
        {
          "id": "RapportPairFFForced",
          "text": "F+F - forced",
          "type": "hotkey",
          "help": "The best-ranked pair of two women near you. If the one you face fits, they are one of the two. Skips the score bar, cooldowns, privacy and time of day."
        },
        {
          "id": "RapportPairFFReal",
          "text": "F+F - real",
          "type": "hotkey",
          "help": "The same, only if that pair clears the bar and nobody is resting. The HUD says why not."
        },
        {
          "id": "RapportPairFMForced",
          "text": "F+M - forced",
          "type": "hotkey",
          "help": "The best-ranked pair of a woman and a man near you. If the one you face fits, they are one of the two. Skips the score bar, cooldowns, privacy and time of day."
        },
        {
          "id": "RapportPairFMReal",
          "text": "F+M - real",
          "type": "hotkey",
          "help": "The same, only if that pair clears the bar and nobody is resting. The HUD says why not."
        },
        {
          "id": "RapportPairMMForced",
          "text": "M+M - forced",
          "type": "hotkey",
          "help": "The best-ranked pair of two men near you. If the one you face fits, they are one of the two. Skips the score bar, cooldowns, privacy and time of day."
        },
        {
          "id": "RapportPairMMReal",
          "text": "M+M - real",
          "type": "hotkey",
          "help": "The same, only if that pair clears the bar and nobody is resting. The HUD says why not."
        }
      ]
    }
  ]
}
