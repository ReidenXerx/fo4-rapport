<mfgSetData xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="common.xsd">
<defaults loadPriority="10"/>

<!--
	GENERATED BY tools/make_mfg.py -- edit that, not this.

	Rapport's own facial expressions.

	The reason these exist: across the entire AAF install there are ten mfgSet
	references in total, and the pack that was playing when the owner first watched
	a Rapport scene has exactly one (Sleep_EyesClosed). The faces are stony because
	the animations never ask for anything else, not because anything is broken.

	Unlike the overlays, this layer costs nothing and depends on nobody: a morph id
	is an index into the engine's own facial morph table, so there is no texture to
	ship and no mod to credit. Rapport can drive faces on a completely vanilla
	install.

	The morph table, 0-49, is quoted from the comment block in
	CHAKPack_mfgSetData.xml -- the only place in the AAF install that writes it
	down. Every other pack ships bare numbers.

	lock="true" holds a morph against whatever else would move it. Rapport_Clear is
	the one set that does not lock, because its whole job is to let go.
-->

<!-- Everything back to zero and unlocked. Applied when a scene ends and when a save is loaded that was made during one, so nobody is left wearing a face Rapport put on them. -->
<mfgSet id="Rapport_Clear">
	<setting morphID="0" intensity="0"/>  <!-- Brow Squeeze -->
	<setting morphID="1" intensity="0"/>  <!-- Jaw Forward -->
	<setting morphID="2" intensity="0"/>  <!-- Jaw Open -->
	<setting morphID="3" intensity="0"/>  <!-- Left Brow Outer Up -->
	<setting morphID="4" intensity="0"/>  <!-- Left Cheek Up -->
	<setting morphID="5" intensity="0"/>  <!-- Left Frown -->
	<setting morphID="6" intensity="0"/>  <!-- Left Jaw -->
	<setting morphID="7" intensity="0"/>  <!-- Left Lip Corner In -->
	<setting morphID="8" intensity="0"/>  <!-- Left Lip Corner Out -->
	<setting morphID="9" intensity="0"/>  <!-- Left Lower Eye Lid Down -->
	<setting morphID="10" intensity="0"/>  <!-- Left Lower Eye Lid Up -->
	<setting morphID="11" intensity="0"/>  <!-- Left Lower Lip Down -->
	<setting morphID="12" intensity="0"/>  <!-- Left Lower Lip Up -->
	<setting morphID="13" intensity="0"/>  <!-- Left Middle Brow Down -->
	<setting morphID="14" intensity="0"/>  <!-- Left Middle Brow Up -->
	<setting morphID="15" intensity="0"/>  <!-- Left Nose Up -->
	<setting morphID="16" intensity="0"/>  <!-- Left Outer Brow Down -->
	<setting morphID="17" intensity="0"/>  <!-- Left Smile -->
	<setting morphID="18" intensity="0"/>  <!-- Left Upper Eye Lid Down -->
	<setting morphID="19" intensity="0"/>  <!-- Left Upper Eye Lid Up -->
	<setting morphID="20" intensity="0"/>  <!-- Left Upper Lip Down -->
	<setting morphID="21" intensity="0"/>  <!-- Left Upper Lip Up -->
	<setting morphID="22" intensity="0"/>  <!-- Lower Lip Funnel -->
	<setting morphID="23" intensity="0"/>  <!-- Lower Lip Roll In -->
	<setting morphID="24" intensity="0"/>  <!-- Lower Lip Roll Out -->
	<setting morphID="25" intensity="0"/>  <!-- Pucker -->
	<setting morphID="26" intensity="0"/>  <!-- Right Outer Brow Up -->
	<setting morphID="27" intensity="0"/>  <!-- Right Cheek Up -->
	<setting morphID="28" intensity="0"/>  <!-- Right Frown -->
	<setting morphID="29" intensity="0"/>  <!-- Right Jaw -->
	<setting morphID="30" intensity="0"/>  <!-- Right Lip Corner In -->
	<setting morphID="31" intensity="0"/>  <!-- Right Lip Corner Out -->
	<setting morphID="32" intensity="0"/>  <!-- Right Lower Eye Lid Down -->
	<setting morphID="33" intensity="0"/>  <!-- Right Lower Eye Lid Up -->
	<setting morphID="34" intensity="0"/>  <!-- Right Lower Lip Down -->
	<setting morphID="35" intensity="0"/>  <!-- Right Lower Lip Up -->
	<setting morphID="36" intensity="0"/>  <!-- Right Middle Brow Down -->
	<setting morphID="37" intensity="0"/>  <!-- Right Middle Brow Up -->
	<setting morphID="38" intensity="0"/>  <!-- Right Nose Up -->
	<setting morphID="39" intensity="0"/>  <!-- Right Outer Brow Down -->
	<setting morphID="40" intensity="0"/>  <!-- Right Smile -->
	<setting morphID="41" intensity="0"/>  <!-- Right Upper Eye Lid Down -->
	<setting morphID="42" intensity="0"/>  <!-- Right Upper Eye Lid Up -->
	<setting morphID="43" intensity="0"/>  <!-- Right Upper Lip Down -->
	<setting morphID="44" intensity="0"/>  <!-- Right Upper Lip Up -->
	<setting morphID="45" intensity="0"/>  <!-- Sticky Lips -->
