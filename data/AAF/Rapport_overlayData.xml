<meta title="Rapport_overlayData.xml" version="1.0" dataSet="overlay"/>

<!--
	Rapport's own overlay sets.

	Two things make these different from the ones that ship with CumOverlays, and
	both are deliberate.

	NO duration. AAF removes an overlayGroup when its duration runs out, and that
	timer is an in-session one: it does not survive a save, a reload, or the game
	closing mid-count, and an overlay stranded that way stays on the actor for
	good. Leaving duration off means AAF applies and never removes, and Rapport
	owns the removal -- in GAME hours, written into the save, so it survives all
	three. The schema says duration is optional (common.xsd, overlayGroupType);
	the shipped cum_overlaysData.xml says the same in its own comments.

	Higher quantity. One overlay reads as a smudge. These pick several at once
	from a wider pool, which is what "a lot" looks like.

	The templates themselves are CumOverlays'. Rapport ships no textures and
	redistributes nothing: it drives the assets that mod already installed, which
	is also why Rapport stops that mod's own quests rather than removing it.
	Without CumOverlays installed these sets resolve to nothing and the rest of
	the framework is unaffected.
-->
<defaults loadPriority="10"/>

<overlaySet id="Rapport_Vaginal">
	<condition isFemale="true">
		<overlayGroup quantity="3">
			<overlay template="Belly_1" alpha="100" isFemale="true"/>
			<overlay template="Belly_2" alpha="100" isFemale="true"/>
			<overlay template="Belly_3" alpha="100" isFemale="true"/>
			<overlay template="Belly_4" alpha="100" isFemale="true"/>
			<overlay template="Belly_5" alpha="100" isFemale="true"/>
			<overlay template="Vaginal_1" alpha="100" isFemale="true"/>
			<overlay template="Vaginal_2" alpha="100" isFemale="true"/>
		</overlayGroup>
	</condition>
	<condition isFemale="false">
		<overlayGroup quantity="2">
			<overlay template="M_Belly_1" alpha="100" isFemale="false"/>
			<overlay template="M_Chest_1" alpha="100" isFemale="false"/>
